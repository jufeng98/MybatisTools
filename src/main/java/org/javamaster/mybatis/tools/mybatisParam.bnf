{
  parserClass="org.javamaster.mybatis.tools.parser.MybatisParamParser"
  parserUtilClass="org.javamaster.mybatis.tools.parser.MybatisParamParserUtil"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="MybatisParam"
  psiImplClassSuffix="Impl"
  psiPackage="org.javamaster.mybatis.tools.psi"
  psiImplPackage="org.javamaster.mybatis.tools.psi.impl"

  elementTypeHolderClass="org.javamaster.mybatis.tools.psi.MybatisParamTypes"
  elementTypeClass="org.javamaster.mybatis.tools.psi.MybatisParamElementType"
  tokenTypeClass="org.javamaster.mybatis.tools.psi.MybatisParamTokenType"
  psiImplUtilClass="org.javamaster.mybatis.tools.psi.impl.MybatisParamPsiImplUtil"

  tokens=[
    SEPARATOR='SEPARATOR'
    ATTR_NAME_LABEL='ATTR_NAME_LABEL'
    ATTR_SEPARATOR='ATTR_SEPARATOR'
    ATTR_VALUE_LABEL='ATTR_VALUE_LABEL'
  ]
}

mybatisParamFile ::= (SEPARATOR attrs)?

attrs ::= (attr SEPARATOR?)*
attr ::= attrName ATTR_SEPARATOR attrValue {
    pin = 1
}
attrName ::= ATTR_NAME_LABEL {
      methods = [
          getName
          getReferences
      ]
      name = "attr name"
}
attrValue ::= ATTR_VALUE_LABEL {
    methods = [
        getName
        getReferences
    ]
    name = "attr value"
}