<idea-plugin>

    <actions>
        <action id="bmd-mybatis-generate-action"
                class="com.baomidou.plugin.idea.mybatisx.generate.action.MybatisGeneratorMainAction"
                text="MybatisX-Generator"
                description="MybatisX generator idea plugin">
            <add-to-group group-id="DatabaseViewPopupMenu" anchor="first"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <annotator language="SQL"
                   implementationClass="org.javamaster.mybatis.tools.annotator.ColumnNameAnnotator"/>

        <intentionAction>
            <language>SQL</language>
            <className>org.javamaster.mybatis.tools.intent.GenerateFieldFromSqlAction</className>
            <category>MyBatisTools/Generate</category>
        </intentionAction>
    </extensions>

</idea-plugin>
