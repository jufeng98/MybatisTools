<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.test.mapper.ExampleMapper">
    <resultMap id="BaseResultMap" type="com.baomidou.mybatis3.domain.Blog">
        <id column="id" property="id"/>
        <result column="age" property="age"/>
        <result column="content" property="content"/>
        <result column="title" property="title"/>
        <result column="money" property="money"/>
    </resultMap>

    <select id="selectTitleAndContentByIdInAndCreateTimeBetweenOrderByAgeDesc" resultMap="BaseResultMap">
        select title, content
        from t_blog
        where id in
        <foreach collection="idlist" item="item" open="(" close=")" separator=",">
            #{item,jdbcType=NUMERIC}
        </foreach>
        AND createTime between #{beginCreateTime,jdbcType=TIMESTAMP} and #{endCreateTime,jdbcType=TIMESTAMP}
            order by age desc
    </select>
</mapper>
