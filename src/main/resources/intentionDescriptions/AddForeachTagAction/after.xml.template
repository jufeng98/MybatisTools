<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.javamaster.invocationlab.admin.rpcpostman.mapper.TestMapper">

    <select id="findList" parameterType="org.javamaster.invocationlab.admin.rpcpostman.model.TestReqVo"
            resultType="org.javamaster.invocationlab.admin.rpcpostman.model.TestResVo">
        select
            tse.order_code
        from
            test_service_exchange tse
        where
            tse.order_status = 1
            and tse.order_code in
        <foreach item="item" index="index" collection="reqVo.orderCodes" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

</mapper>